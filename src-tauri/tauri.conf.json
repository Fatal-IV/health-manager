{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sağlık Denetimi",
  "version": "0.1.0",
  "identifier": "com.ik.saglikdenetimi",
  "build": {
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ../ui run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      { "title": "Sağlık Denetimi", "width": 1000, "height": 700 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
