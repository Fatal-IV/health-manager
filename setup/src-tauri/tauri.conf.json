{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sağlık Denetimi Kurulumu",
  "mainBinaryName": "saglik-denetimi-setup",
  "version": "0.3.10",
  "identifier": "com.ik.saglikdenetimi.setup",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Sağlık Denetimi Kurulumu",
        "width": 560,
        "height": 380,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "center": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
